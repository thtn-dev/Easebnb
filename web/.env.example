# Base URL of the backend API as seen from the browser.
# Leave empty (default) to use same-origin "/api" — recommended: requests are
# proxied to the backend by the API_PROXY_URL rewrite in next.config.ts,
# so there is no CORS and cookies just work.
# Set an absolute URL (e.g. https://api.example.com) to call the API directly.
NEXT_PUBLIC_API_URL=

# Server-only: origin of the .NET backend, e.g. http://localhost:5282
# - next.config.ts rewrites browser /api/* requests to ${API_PROXY_URL}/api/*
#   (the /api/v1/auth endpoints live under this prefix)
# - Server-side rendering uses it to call the backend directly.
# Never exposed to the browser. Optional — without it no proxy is installed.
API_PROXY_URL=
