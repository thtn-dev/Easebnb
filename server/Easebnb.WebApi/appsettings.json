{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost; Database=easebnb; Username=postgres; Password=postgres;"
  },
  "RabbitMq": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Jwt": {
    "Issuer": "YourAudienceHere",
    "Audience": "YourAudienceHere",
    "AccessTokenExpiryMinutes": 60
  },
  "GoogleAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "RedirectUri": "YOUR_REDIRECT_URI"
  },
  "ObjectStorage": {
    "S3": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "admin",
      "SecretKey": "secret-key-12345",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "UploadSettings": {
    "GlobalMaxBodySizeBytes": 31457280,
    "Avatar": {
      "MaxFileSizeBytes": 5242880,
      "MaxDimension": 512
    },
    "OrganizationLogo": {
      "MaxFileSizeBytes": 5242880,
      "MaxDimension": 512
    }
  }
}